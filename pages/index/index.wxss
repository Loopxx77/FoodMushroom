page { height: 100%; background: #f7f7f7; }
.page-scroll { height: 100vh; width: 100%; }
.page-container { display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding: 80rpx 40rpx 60rpx; box-sizing: border-box; }
.title { font-size: 44rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; text-align: center; }
.subtitle { font-size: 28rpx; color: #777; margin-bottom: 40rpx; text-align: center; }
.guli-card, .form-card, .history-card { width: 100%; box-sizing: border-box; padding: 36rpx; border-radius: 24rpx; background: #fff; margin-bottom: 28rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.04); }
.guli-card { background: #eaf8ef; text-align: center; }
.card-title { font-size: 32rpx; font-weight: bold; color: #333; }
.total-value { font-size: 64rpx; font-weight: bold; color: #078642; margin: 16rpx 0; }
.unit { font-size: 26rpx; font-weight: normal; }
.muted { font-size: 24rpx; color: #777; }
.form-input { width: 100%; height: 90rpx; background: #f5f5f5; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 24rpx; font-size: 30rpx; box-sizing: border-box; }
.confirm-button { width: 100%; min-height: 90rpx; line-height: 90rpx; background: #07c160; color: #fff; font-size: 32rpx; font-weight: bold; border-radius: 16rpx; }
.confirm-button[disabled] { background: #a4d9bc; color: #fff; }
.result-box { margin: 0 0 28rpx; font-size: 28rpx; color: #078642; text-align: center; }
.history-note { margin-top: 12rpx; line-height: 1.6; }
.empty-state { padding: 30rpx 0 8rpx; font-size: 26rpx; color: #777; line-height: 1.6; }
.history-item { padding: 24rpx 0; border-bottom: 1rpx solid #eee; }
.history-item:last-child { border-bottom: none; padding-bottom: 0; }
.history-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.history-gain { color: #078642; font-size: 28rpx; font-weight: bold; }
.food-line { font-size: 28rpx; color: #333; line-height: 1.7; word-break: break-all; }
.history-actions { display: flex; margin-top: 24rpx; }
.history-button { flex: 1; margin: 0; padding: 0 8rpx; font-size: 26rpx; line-height: 76rpx; border-radius: 12rpx; color: #078642; background: #eaf8ef; }
.history-button + .history-button { margin-left: 16rpx; }
.danger-button { color: #b63529; background: #fff0ed; }
.history-button[disabled] { color: #999; background: #f3f3f3; }
